{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "gcc: build LFTC_ALEX",
      "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
      "args": [
        "-g",
        "-Wall",
        "main.c",
        "lexer.c",
        "utils.c",
        "-o",
        "alex.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\LFTC_ALEX",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "gcc: run LFTC_ALEX",
      "command": ".\\alex.exe",
      "options": {
        "cwd": "${workspaceFolder}\\LFTC_ALEX"
      },
      "dependsOn": "gcc: build LFTC_ALEX",
      "problemMatcher": []
    },
    {
      "type": "cppbuild",
      "label": "C/C++: cl.exe build active file",
      "command": "cl.exe",
      "args": [
        "/Zi",
        "/EHsc",
        "/nologo",
        "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": "build",
      "detail": "Task generated by Debugger."
    }
  ],
  "version": "2.0.0"
}
